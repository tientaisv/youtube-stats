# Server Port
PORT=9090

# Database Configuration (sqlite or postgres)
DB_TYPE=sqlite
DB_DSN=youtube_stats.db

# PostgreSQL Example:
# DB_TYPE=postgres
# DB_DSN=host=postgres port=5432 user=postgres password=postgrespassword dbname=youtube_stats sslmode=disable

# Google YouTube API Keys (Comma-separated for auto-rotation pool)
YOUTUBE_API_KEYS=AIzaSyYourFirstKeyHere,AIzaSyYourSecondKeyHere

# Cron Schedule (Default: 0 */6 * * * -> Every 6 hours)
CRON_SCHEDULE="0 */6 * * *"
